#!/usr/bin/env bash
set -euo pipefail

root="$(cd "$(dirname "$0")/../.." && pwd)"
: "${TARGET:?expected a release platform target}"
cd "$root/backend"
output="$root/dist/plugin-platform-$TARGET"
mkdir -p "$output"
exec > >(tee "$output/check.log") 2>&1

# Tests execute on the target architecture; emulated cross-compilation alone is
# insufficient evidence for process startup, RPC, archive modes or shutdown.
host="$(rustc -vV | sed -n 's/^host: //p')"
test "$host" = "$TARGET"
git -C "$root" rev-parse HEAD > "$output/commit.txt"
cp "$root/release/version.yaml" "$output/version.yaml"
rustc -vV
cargo test --locked --target "$TARGET" -p gateway-plugin-sdk -p codex-proxy-plugin-cli -p cpr-shared-budget-plugin --test main
cargo test --locked --target "$TARGET" -p gateway-plugin-runtime --all-features --test main installation::
cargo build --release --locked --target "$TARGET" -p codex-proxy-rs -p codex-proxy-plugin-cli -p cpr-shared-budget-plugin --bins

for binary in codex-proxy-rs cpr-plugin cpr-shared-budget-plugin; do
  cp "target/$TARGET/release/$binary" "$output/$binary"
done
"$output/codex-proxy-rs" --help
"$output/cpr-plugin" package --help
"$output/cpr-plugin" package --manifest apps/shared-budget-plugin/plugin.json \
  --binary "$output/cpr-shared-budget-plugin" --target "$TARGET" \
  --output-dir "$output/plugins" --resource-map web=web
(cd "$output" && shasum -a 256 codex-proxy-rs cpr-plugin cpr-shared-budget-plugin > SHA256SUMS)
printf '%s\n' 'Native plugin checks and release binaries completed.'
